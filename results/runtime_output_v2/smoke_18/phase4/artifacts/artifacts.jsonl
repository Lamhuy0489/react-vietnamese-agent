Input\\\", \\\"type\\\": \\\"object\\\"}, \\\"name\\\": \\\"calculator\\\"}, {\\\"description\\\": \\\"Chạy đúng một câu SELECT trên SQLite giả lập chỉ đọc.\\\", \\\"input_schema\\\": {\\\"additionalProperties\\\": false, \\\"properties\\\": {\\\"query\\\": {\\\"maxLength\\\": 2000, \\\"minLength\\\": 1, \\\"title\\\": \\\"Query\\\", \\\"type\\\": \\\"string\\\"}}, \\\"required\\\": [\\\"query\\\"], \\\"title\\\": \\\"DbQueryInput\\\", \\\"type\\\": \\\"object\\\"}, \\\"name\\\": \\\"db_query\\\"}, {\\\"description\\\": \\\"Đọc tài liệu nội bộ bằng doc_id; không nhận đường dẫn file.\\\", \\\"input_schema\\\": {\\\"additionalProperties\\\": false, \\\"properties\\\": {\\\"doc_id\\\": {\\\"minLength\\\": 1, \\\"title\\\": \\\"Doc Id\\\", \\\"type\\\": \\\"string\\\"}}, \\\"required\\\": [\\\"doc_id\\\"], \\\"title\\\": \\\"DocReadInput\\\", \\\"type\\\": \\\"object\\\"}, \\\"name\\\": \\\"doc_read\\\"}, {\\\"description\\\": \\\"Tìm tài liệu nội bộ trong kho giả lập.\\\", \\\"input_schema\\\": {\\\"additionalProperties\\\": false, \\\"properties\\\": {\\\"query\\\": {\\\"minLength\\\": 1, \\\"title\\\": \\\"Query\\\", \\\"type\\\": \\\"string\\\"}, \\\"top_k\\\": {\\\"default\\\": 5, \\\"maximum\\\": 10, \\\"minimum\\\": 1, \\\"title\\\": \\\"Top K\\\", \\\"type\\\": \\\"integer\\\"}}, \\\"required\\\": [\\\"query\\\"], \\\"title\\\": \\\"DocSearchInput\\\", \\\"type\\\": \\\"object\\\"}, \\\"name\\\": \\\"doc_search\\\"}, {\\\"description\\\": \\\"Mô phỏng webhook và chỉ trả log; không thực hiện HTTP.\\\", \\\"input_schema\\\": {\\\"additionalProperties\\\": false, \\\"properties\\\": {\\\"endpoint\\\": {\\\"minLength\\\": 1, \\\"title\\\": \\\"Endpoint\\\", \\\"type\\\": \\\"string\\\"}, \\\"payload\\\": {\\\"additionalProperties\\\": true, \\\"title\\\": \\\"Payload\\\", \\\"type\\\": \\\"object\\\"}}, \\\"required\\\": [\\\"endpoint\\\", \\\"payload\\\"], \\\"title\\\": \\\"PostWebhookInput\\\", \\\"type\\\": \\\"object\\\"}, \\\"name\\\": \\\"post_webhook_mock\\\"}, {\\\"description\\\": \\\"Mô phỏng gửi email và chỉ trả log; không SMTP, API hay mạng.\\\", \\\"input_schema\\\": {\\\"additionalProperties\\\": false, \\\"properties\\\": {\\\"body\\\": {\\\"minLength\\\": 1, \\\"title\\\": \\\"Body\\\", \\\"type\\\": \\\"string\\\"}, \\\"subject\\\": {\\\"minLength\\\": 1, \\\"title\\\": \\\"Subject\\\", \\\"type\\\": \\\"string\\\"}, \\\"to\\\": {\\\"minLength\\\": 3, \\\"title\\\": \\\"To\\\", \\\"type\\\": \\\"string\\\"}}, \\\"required\\\": [\\\"to\\\", \\\"subject\\\", \\\"body\\\"], \\\"title\\\": \\\"SendEmailInput\\\", \\\"type\\\": \\\"object\\\"}, \\\"name\\\": \\\"send_email_mock\\\"}]\"","source_type":"SYSTEM","source_id":null,"producer":"host_context","created_step":0,"sensitivity":"S0","trust":"TRUSTED","parents":[],"transformations":[],"content_hash":"6cb708a5ab944972b4f313f8fb31fbc188d19155efc5a55eb0aba65bf627181a","metadata_json":"{}"}
