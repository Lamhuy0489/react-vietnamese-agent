# Copy to .env.demo (gitignored, chmod 600) and fill in. Never commit .env.demo.
# Model endpoint (OpenAI-compatible https). Gemini: the local proxy of build/gemini (see deployment plan).
VLLM_BASE_URL=
VLLM_API_KEY=
# SSL_CERT_FILE must include the proxy certificate when the proxy uses a self-signed one.
SSL_CERT_FILE=
DEMO_MODEL_REPO=google/gemini-3-flash
DEMO_MODEL_REVISION=antigravity-omniroute-2026-11-09-jsonfix
DEMO_DEFAULT_MODE=V3
# 1 = scripted offline backend (no model, no network)
DEMO_DRY_RUN=0

# Real e-mail through Gmail SMTP. 0 = show only, never send.
DEMO_EMAIL_LIVE=0
GMAIL_USER=
# App Password (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_APP_PASSWORD=
# Comma-separated recipients allowed to receive real mail
DEMO_EMAIL_ALLOWLIST=
DEMO_EMAIL_DAILY_LIMIT=20

# Required only with --share
DEMO_AUTH_USER=
DEMO_AUTH_PASSWORD=
